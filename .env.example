# Copy to .env for local development. Never commit the filled-in file.
# On Cloudflare these same names go in .dev.vars (local) and `wrangler secret`
# / the dashboard (deployed).

# --- Database (required) ---------------------------------------------------
# Neon Postgres connection string. Prisma talks to it over HTTP fetch, which is
# what makes it work on Workers.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Authentication (required) ---------------------------------------------
# A random secret: `openssl rand -base64 32`
NEXTAUTH_SECRET=""
# The site's own origin. http://localhost:3000 locally.
NEXTAUTH_URL="http://localhost:3000"

# Staff sign in with Google and/or Microsoft. Configure at least one.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID="common"

# Staff can also sign in with a link by email. Uses the same Resend key as the
# booking mail below, because Cloudflare Workers has no raw TCP for SMTP.
# A link is only sent to an address already on the staff list.

# --- Access control --------------------------------------------------------
# Comma-separated addresses that are always admins. IMPORTANT: while this is
# empty, ANY successful sign-in is allowed in as staff, which is only meant for
# first-run bootstrapping. Set it as soon as you have signed in once.
ADMIN_EMAILS=""

# --- Optional --------------------------------------------------------------
# Public site origin, used for absolute URLs in metadata and structured data.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Mirror season-update signups into MailerLite. Leave unset to keep them only
# in our own database.
MAILERLITE_API_KEY=""
MAILERLITE_GROUP_ID=""
